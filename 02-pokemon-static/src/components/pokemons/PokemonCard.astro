---
// Client-side Rendering (CSR) - Renderizado en el cliente
interface Props {
    url: string;
    name: string;
    isBig?: boolean;
}
const { name, url, isBig = false } = Astro.props;
const id = url.split("/").at(-2)!;
const imageSrc = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
---

<!-- href={`/pokemons/${id}`} -->
<a
    href={`/pokemons/${name}`}
    class:list={[
        "rounded flex flex-col justify-center items-center p-2",
        {
            border: !isBig,
        },
    ]}
>
    <img
        transition:name={`${name}-image`}
        class:list={[
            {
                "w-96 h-96": isBig,
                "w-22 h-22": !isBig,
            },
        ]}
        src={imageSrc}
        alt={name}
    />
    <span
        class:list={[
            "capitalize",
            {
                "text-2xl font-black text-blue-300": isBig,
                "text-base": !isBig,
            },
        ]}>#{id} {name}</span
    >
</a>
