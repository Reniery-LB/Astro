---
// Código Server Side Only - Momento de construcción BUILD TIME
import MainLayout from "../layouts/MainLayout.astro";
import type { PokemonListResponse } from "../interfaces/pokemon-list.response";
import PokemonCard from "../components/pokemons/PokemonCard.astro";

const resp = await fetch("https://pokeapi.co/api/v2/pokemon?limit=20"); // "https://pokeapi.co/api/v2/pokemon?limit=100000&offset=0"
const data = (await resp.json()) as PokemonListResponse;
const title = "Pokemons Static | Home";
---

<MainLayout title={title}>
	<h1 class="text-3xl">Listado de Pokemons</h1>
	<hr />

	<section
		aria-label="Listado de pokemons"
		class="grid grid-cols-1 sm:grid-cols-4 md:grid-cols-5 gap-4 mt-10"
	>
		{
			data.results.map((pokemon) => (
				<PokemonCard name={pokemon.name} url={pokemon.url} />
			))
		}
	</section>
</MainLayout>
